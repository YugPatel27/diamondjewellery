# ═══════════════════════════════════════════════════
# Diamond Jewels — Server Environment Configuration
# ═══════════════════════════════════════════════════
# ⚠️  NEVER commit .env files to version control!
# Copy this file to .env and fill in your values.

# MongoDB Configuration
# For local MongoDB: mongodb://localhost:27017/jewellery
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/jewellery
MONGODB_URI=mongodb://localhost:27017/jewellery

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# JWT Configuration
# ⚠️  CRITICAL: Generate a strong random secret (min 32 chars) for production!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_use_crypto_randomBytes_64_to_generate
JWT_EXPIRE=7d
