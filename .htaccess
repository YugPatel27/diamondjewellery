# Enable mod_rewrite for clean URLs
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Remove .html extension from URLs
  RewriteCond %{SCRIPT_FILENAME} !-l
  RewriteCond %{SCRIPT_FILENAME} !-d
  RewriteRule ^(.*)$ index.html [L]
</IfModule>

# Cache control for static assets - 1 year cache for hashed files
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Cache static assets with far-future expires headers (1 year)
  <FilesMatch "\.(gif|jpg|jpeg|png|webp|ico|svg|woff|woff2|eot|ttf|otf)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Cache JavaScript and CSS files with far-future expires headers
  <FilesMatch "\.min\.(js|css)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Cache hashed assets
  <FilesMatch "\.[a-f0-9]{8,}\.(js|css)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Cache font files
  <FilesMatch "\.(woff|woff2|ttf|eot)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Short cache for HTML and JSON - can be updated
  <FilesMatch "\.(html|json)$">
    ExpiresDefault "access plus 1 hour"
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  
  # Default
  ExpiresDefault "access plus 2 days"
</IfModule>

# GZIP Compression for text assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml+rss application/atom+xml
  
  # Compress SVG files
  <FilesMatch "\.svg$">
    AddOutputFilterByType DEFLATE image/svg+xml
  </FilesMatch>
</IfModule>

# Remove unnecessary HTTP headers
<IfModule mod_headers.c>
  # Security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Performance headers
  Header set Content-Security-Policy "default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self';"
  
  # Enable HSTS
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  
  # Disable ETag
  Header unset ETag
  FileETag None
</IfModule>

# Disable directory listing
Options -Indexes

# Enable Gzip via env variable (for some servers)
<IfModule mod_env.c>
  SetEnv COMPRESS_LEVEL 9
</IfModule>